<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:background="@drawable/tv_row"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <FrameLayout android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/tv_logo_tile" android:padding="6dp">
        <ImageView android:id="@+id/row_logo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/row_initials" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:textColor="#22252F" android:textSize="20sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/row_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/tv_text" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/row_sub" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/tv_text_dim" android:textSize="14sp" />
        <ProgressBar android:id="@+id/row_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="160dp" android:layout_height="4dp"
            android:layout_marginTop="6dp" android:max="1000" android:progressDrawable="@drawable/tv_progress" />
    </LinearLayout>
    <TextView android:id="@+id/row_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/tv_live_badge"
        android:paddingStart="8dp" android:paddingTop="2dp" android:paddingEnd="8dp" android:paddingBottom="2dp" android:text="PLAYING"
        android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
</LinearLayout>
