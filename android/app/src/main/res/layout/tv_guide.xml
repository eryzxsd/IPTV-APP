<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:orientation="horizontal">
    <LinearLayout android:layout_width="440dp" android:layout_height="match_parent" android:background="@color/tv_surface" android:orientation="vertical" android:paddingTop="48dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="32dp" android:text="TV Guide"
            android:textColor="@color/tv_text" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:id="@+id/guide_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="32dp" android:paddingBottom="12dp"
            android:textColor="@color/tv_text_dim" android:textSize="15sp" />
        <androidx.leanback.widget.VerticalGridView android:id="@+id/guide_channels" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:paddingTop="52dp" android:paddingStart="40dp" android:paddingEnd="48dp">
        <TextView android:id="@+id/guide_channel" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/tv_text" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/guide_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp"
            android:text="Press OK to watch" android:textColor="@color/tv_text_dim" android:textSize="15sp" />
        <androidx.leanback.widget.VerticalGridView android:id="@+id/guide_programmes" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingBottom="24dp" />
    </LinearLayout>
</LinearLayout>
