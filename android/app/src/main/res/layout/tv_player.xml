<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tv_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ProgressBar
        android:id="@+id/loading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/tv_cyan" />

    <!-- Error / still-connecting message -->
    <LinearLayout
        android:id="@+id/message"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_pill"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">
        <TextView android:id="@+id/message_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/tv_text" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/message_body" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/tv_text_dim" android:textSize="16sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <Button android:id="@+id/message_primary" style="@style/TvPlayerButton" />
            <Button android:id="@+id/message_next" style="@style/TvPlayerButton" android:text="Next channel" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="@drawable/tv_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/tv_text"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Info bar + controls (OK on the remote) -->
    <LinearLayout
        android:id="@+id/info_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/tv_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="96dp"
        android:paddingEnd="56dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/tv_logo_tile" android:padding="10dp">
                <ImageView android:id="@+id/logo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" />
                <TextView android:id="@+id/logo_initials" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
                    android:textColor="#22252F" android:textSize="30sp" android:textStyle="bold" android:visibility="gone" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/channel_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textColor="@color/tv_text" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:id="@+id/live" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="14dp"
                        android:background="@drawable/tv_live_badge" android:paddingStart="10dp" android:paddingTop="2dp" android:paddingEnd="10dp" android:paddingBottom="2dp"
                        android:text="LIVE" android:textColor="@android:color/white" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:id="@+id/quality" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                        android:background="@drawable/tv_pill" android:paddingStart="10dp" android:paddingTop="2dp" android:paddingEnd="10dp" android:paddingBottom="2dp"
                        android:textColor="@color/tv_text" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/now_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                    android:maxLines="1" android:ellipsize="end" android:textColor="@color/tv_text" android:textSize="22sp" />
                <TextView android:id="@+id/now_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="@color/tv_text_dim" android:textSize="16sp" />
                <ProgressBar android:id="@+id/now_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
                    android:layout_marginTop="10dp" android:max="1000" android:progressDrawable="@drawable/tv_progress" />
                <TextView android:id="@+id/next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:maxLines="1" android:ellipsize="end" android:textColor="@color/tv_text_dim" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/buttons" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">
            <Button android:id="@+id/btn_play" style="@style/TvPlayerButton" android:text="Pause" />
            <Button android:id="@+id/btn_channels" style="@style/TvPlayerButton" android:text="Channels" />
            <Button android:id="@+id/btn_subtitles" style="@style/TvPlayerButton" android:text="Subtitles" />
            <Button android:id="@+id/btn_audio" style="@style/TvPlayerButton" android:text="Audio" />
            <Button android:id="@+id/btn_quality" style="@style/TvPlayerButton" android:text="Quality" />
            <Button android:id="@+id/btn_more" style="@style/TvPlayerButton" android:text="More" />
            <Button android:id="@+id/btn_favorite" style="@style/TvPlayerButton" android:text="☆ Favorite" />
        </LinearLayout>
    </LinearLayout>

    <!-- Channel list (Left / Guide / Menu on the remote) -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:background="#F2101320"
        android:orientation="vertical"
        android:paddingTop="32dp"
        android:visibility="gone">
        <TextView android:id="@+id/panel_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:text="Channels" android:textColor="@color/tv_text" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/panel_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="28dp" android:paddingEnd="28dp"
            android:paddingBottom="12dp" android:textColor="@color/tv_text_dim" android:textSize="15sp" />
        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/panel_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</FrameLayout>
