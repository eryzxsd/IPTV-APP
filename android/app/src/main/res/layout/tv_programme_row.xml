<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/tv_row"
    android:focusable="true"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="14dp">
    <TextView android:id="@+id/prog_time" android:layout_width="110dp" android:layout_height="wrap_content"
        android:textColor="@color/tv_text_dim" android:textSize="18sp" android:textStyle="bold" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/prog_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/tv_text" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/prog_now" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp"
                android:background="@drawable/tv_live_badge" android:paddingStart="8dp" android:paddingTop="1dp" android:paddingEnd="8dp" android:paddingBottom="1dp"
                android:text="NOW" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/prog_desc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2"
            android:ellipsize="end" android:textColor="@color/tv_text_dim" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/prog_dur" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:textColor="@color/tv_text_dim" android:textSize="15sp" />
</LinearLayout>
